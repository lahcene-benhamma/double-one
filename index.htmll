<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
/* =========================================================
   CONFIGURATION — le seul endroit à modifier pour le contenu
   ========================================================= */

// Logo : mettre le chemin du fichier original (ex. "logo.png").
// Laisser vide pour afficher un logotype texte provisoire.
const LOGO_SRC = "assets/logo.png";

const WHATSAPP = "213773014399";
const MAPS_URL = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("DOUBLE ONE clothing P59P+7C7 Bab Ezzouar Alger");

/* ARTICLES — ajouter un objet par article.
   Exemple :
   { name: "Hoodie Noir Oversize",
     description: "Coton épais, coupe ample.",
     price: 6500,                 // en DA
     image: "photos/hoodie-noir.jpg" }
*/
const PRODUCTS = [
  {
    name: "Hoodie Zip Boxy Black Edition",
    description: "Coton peigné lourd 450 GSM, zip métal intégral, sérigraphie embossée.",
    price: 6500,
    image: "assets/articles/hoodie-zip-noir.jpg"
  },
  {
    name: "Pantalon Jogger Graphic Double One",
    description: "Coton molleton épais, coupe loose streetwear, print signature blanc.",
    price: 5400,
    image: "assets/articles/jogger-graphic-noir.jpg"
  },
  {
    name: "Jean Baggy Skater Bleu Clair",
    description: "Denim bleached délavé clair, coupe ultra baggy skater, finitions authentiques.",
    price: 5900,
    image: "assets/articles/jean-baggy-bleu-clair.jpg"
  },
  {
    name: "Pull Maille Côtelée Bordeaux",
    description: "Tricot lourd col rond, coupe structurée premium, broderie iconique.",
    price: 6200,
    image: "assets/articles/pull-tricot-bordeaux.jpg"
  },
  {
    name: "Sweat Half-Zip Beige 'Saint'",
    description: "Col montant zippé métal, broderie torse glitter, intérieur fleece doux.",
    price: 6400,
    image: "assets/articles/sweat-half-zip-beige-saint.jpg"
  },
  {
    name: "Jean Wide Leg Noir Délavé",
    description: "Denim lourd 13.5 oz, coupe large relaxed, délavage vintage.",
    price: 5800,
    image: "assets/articles/jean-noir-wide.jpg"
  },
  {
    name: "Hoodie Bleu 'Spirits of a Dreamer'",
    description: "Bleu cobalt vibrant, broderie cursive dos haute précision, coupe boxy.",
    price: 6600,
    image: "assets/articles/hoodie-bleu-spirits.jpg"
  },
  {
    name: "Jean Baggy Vintage Acid Grey",
    description: "Denim authentique épais, coupe baggy streetwear, effet marbré.",
    price: 5800,
    image: "assets/articles/jean-gris-vintage.jpg"
  },
  {
    name: "Jean Regular Noir Surpiqûres",
    description: "Denim brut lavé noir profond, surpiqûres blanches contrastées, coupe droite.",
    price: 5600,
    image: "assets/articles/jean-noir-surpiqures.jpg"
  }
];

/* ========================================================= */

// Logo
(function(){
  const a = document.getElementById("logo-link");
  if (LOGO_SRC) {
    a.innerHTML = '<img src="' + LOGO_SRC + '" alt="DOUBLE ONE Logo"><span>DOUBLE ONE</span>';
  } else {
    a.innerHTML = '<span class="mark" aria-hidden="true"><span>1</span><span>1</span></span><span>DOUBLE ONE</span>';
  }
})();

// Liens
document.getElementById("maps").href = MAPS_URL;
document.getElementById("yr").textContent = new Date().getFullYear();

function igCommander(name, price) {
  var msg = 'Bonjour DOUBLE ONE \uD83D\uDC4B\nJe veux commander : ' + name + '\nPrix : ' + price;
  if (navigator.clipboard) { navigator.clipboard.writeText(msg).catch(function(){}); }
  // Toast
  var t = document.getElementById('ig-toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'ig-toast';
    t.style.cssText = 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(100px);background:#111;color:#fff;padding:.8rem 1.6rem;border-radius:2rem;font-size:.85rem;font-family:inherit;box-shadow:0 4px 24px rgba(0,0,0,.5);z-index:9999;transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s;opacity:0;white-space:nowrap;display:flex;align-items:center;gap:.6rem;pointer-events:none';
    document.body.appendChild(t);
  }
  t.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Message copié ! Collez-le dans le DM <strong>@double_one.dz</strong></span>';
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._tid);
  t._tid = setTimeout(function() {
    t.style.opacity = '0'; t.style.transform = 'translateX(-50%) translateY(100px)';
  }, 3500);
  setTimeout(function() { window.open('https://www.instagram.com/double_one.dz/', '_blank', 'noopener'); }, 400);
}
// Délégation de clic (pas d'inline JS — aucun problème d'échappement)
document.addEventListener('click', function(e) {
  var btn = e.target.closest('[data-ig-name]');
  if (btn) igCommander(btn.getAttribute('data-ig-name'), btn.getAttribute('data-ig-price'));
});

// Collection
(function(){
  var box = document.getElementById('products');
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  if (!PRODUCTS.length) {
    box.innerHTML = '<div class="empty"><h3>Collection bient\u00f4t disponible</h3>'
      + '<p>Les premiers articles arrivent. Passez en boutique ou \u00e9crivez-nous pour conna\u00eetre les nouveaut\u00e9s.</p>'
      + '<a class="btn solid" href="https://www.instagram.com/double_one.dz/" target="_blank" rel="noopener">Nous contacter sur Instagram</a></div>';
    return;
  }
  function fmt(n) {
    return new Intl.NumberFormat('fr-DZ').format(n).replace(/[\u202f\u00a0]/g, ' ') + ' DA';
  }
  box.innerHTML = '<div class="grid">' + PRODUCTS.map(function(p) {
    var price = fmt(p.price);
    return '<article class="card">'
      + '<div class="ph"><img src="' + esc(p.image) + '" alt="' + esc(p.name) + '" loading="lazy"></div>'
      + '<div class="b">'
      + '<h3>' + esc(p.name) + '</h3>'
      + '<p>' + esc(p.description || '') + '</p>'
      + '<div class="price">' + price + '</div>'
      + '<button class="btn solid" data-ig-name="' + esc(p.name) + '" data-ig-price="' + esc(price) + '">Commander sur Instagram</button>'
      + '</div></article>';
  }).join('') + '</div>';
})();

// Hero tunnel : défilement 3D. Le scroll de la page n'est capturé que pendant la traversée.
(function(){
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const hero = document.getElementById("accueil"), stage = document.getElementById("stage");
  const ITEMS = [
    { title: "DOUBLE ONE", src: "assets/articles/hoodie-zip-noir.jpg" },
    { title: "Streetwear", src: "assets/articles/jogger-graphic-noir.jpg" },
    { title: "Bab Ezzouar", src: "assets/articles/jean-baggy-bleu-clair.jpg" },
    { title: "Alger", src: "assets/articles/pull-tricot-bordeaux.jpg" },
    { title: "Bientôt", src: "assets/articles/sweat-half-zip-beige-saint.jpg" },
    { title: "Nouveaux articles", src: "assets/articles/jean-noir-wide.jpg" },
    { title: "Urbain", src: "assets/articles/hoodie-bleu-spirits.jpg" },
    { title: "Premium", src: "assets/articles/jean-gris-vintage.jpg" },
    { title: "11", src: "assets/articles/jean-noir-surpiqures.jpg" }
  ];
  const texts = hero.querySelectorAll("h1, p.tag");
  const hint = document.createElement("p");
  hint.textContent = "Faites défiler";
  hint.style.cssText = "position:absolute;bottom:20px;left:0;right:0;text-align:center;font-size:.75rem;letter-spacing:.3em;text-transform:uppercase;color:#888;pointer-events:none";
  hero.appendChild(hint);
  const N = ITEMS.length, SPAN = .55;
  const cards = ITEMS.map((it, i) => {
    const el = document.createElement("div"); el.className = "tc";
    if (it.src) {
      const im = new Image(); im.src = it.src; im.alt = it.title || ""; im.loading = "lazy";
      el.appendChild(im);
      if (it.title) {
        const lbl = document.createElement("span");
        lbl.className = "tc-lbl";
        lbl.textContent = it.title;
        el.appendChild(lbl);
      }
    } else {
      el.textContent = it.title;
    }
    stage.appendChild(el);
    const a = i * 137.5 * Math.PI / 180;
    return { el, start:(i/N)*(1-SPAN), c:Math.cos(a), s:Math.sin(a), rx:.28+(i%3)*.08, ry:.26+(i%2)*.09, rot:(i%2?-1:1)*(3+(i%5)*2), z:i+1 };
  });
  const clamp = (v, a=0, b=1) => Math.min(b, Math.max(a, v));
  let target = .1, p = .1, tx = 0, ty = 0, px = 0, py = 0, running = false;
  function render(){
    const w = hero.clientWidth, h = hero.clientHeight, m = w < 768;
    const cw = m ? clamp(w*.38,130,180) : clamp(w*.18,180,270);
    const far = m ? -1200 : -1700, near = m ? 350 : 500, pan = m ? 20 : 45;
    stage.style.perspective = (m ? 900 : 1200) + "px";
    for (const k of cards) {
      const lp = clamp((p - k.start) / SPAN);
      const z = far + (near - far) * lp;
      const o = lp < .18 ? lp/.18 : lp < .82 ? 1 : lp < .98 ? (.98-lp)/.16 : 0;
      const x = k.c*w*k.rx - px*pan, y = k.s*h*k.ry - py*pan;
      k.el.style.width = cw + "px";
      k.el.style.opacity = o;
      k.el.style.zIndex = k.z;
      k.el.style.transform = `translate3d(calc(-50% + ${x}px), calc(-50% + ${y}px), ${z}px) rotateZ(${k.rot}deg)`;
    }
    const sc = p < .5 ? .85 + .3*p : 1 + .5*(p-.5);
    const op = p < .12 ? .6 + .4*(p/.12) : p < .85 ? 1 : clamp((1-p)/.15);
    texts.forEach(t => { t.style.transform = `scale(${sc})`; t.style.opacity = op; });
    hint.style.opacity = clamp(1 - p/.4);
  }
  function frame(){
    p += (target - p) * .08; px += (tx - px) * .06; py += (ty - py) * .06;
    render();
    if (Math.abs(target-p) > .0005 || Math.abs(tx-px) > .001 || Math.abs(ty-py) > .001) requestAnimationFrame(frame); else running = false;
  }
  function kick(){ if (!running) { running = true; requestAnimationFrame(frame); } }
  function move(d, e){
    if (window.scrollY > 8) return;
    const n = clamp(target + d);
    if (n === target) return;            // bords atteints : le scroll normal reprend
    if (e.cancelable) e.preventDefault();
    target = n; kick();
  }
  hero.addEventListener("wheel", e => move(e.deltaY * .0008, e), { passive:false });
  let ly = 0;
  hero.addEventListener("touchstart", e => { ly = e.touches[0].clientY; }, { passive:true });
  hero.addEventListener("touchmove", e => { const y = e.touches[0].clientY; move((ly - y) * .003, e); ly = y; }, { passive:false });
  window.addEventListener("pointermove", e => { tx = (e.clientX/innerWidth - .5)*2; ty = (e.clientY/innerHeight - .5)*2; kick(); }, { passive:true });
  window.addEventListener("resize", render);
  render();
})();

// Lookbook Cylindrique 3D (Photos entières sans lamelles sur courbe 3D)
(function initTiltedGridHero(){
  const container = document.getElementById("tilted-grid-hero");
  if (!container) return;

  const IMAGES = [
    { src: "assets/articles/hoodie-zip-noir.jpg", title: "Hoodie Zip Boxy Black", price: "6 500 DA" },
    { src: "assets/articles/jogger-graphic-noir.jpg", title: "Pantalon Jogger Graphic", price: "5 400 DA" },
    { src: "assets/articles/jean-baggy-bleu-clair.jpg", title: "Jean Baggy Skater Bleached", price: "5 900 DA" },
    { src: "assets/articles/pull-tricot-bordeaux.jpg", title: "Pull Maille Côtelée Bordeaux", price: "6 200 DA" },
    { src: "assets/articles/sweat-half-zip-beige-saint.jpg", title: "Sweat Half-Zip Saint", price: "6 400 DA" },
    { src: "assets/articles/jean-noir-wide.jpg", title: "Jean Wide Leg Noir Délavé", price: "5 800 DA" },
    { src: "assets/articles/hoodie-bleu-spirits.jpg", title: "Hoodie Bleu Spirits Cobalt", price: "6 600 DA" },
    { src: "assets/articles/jean-gris-vintage.jpg", title: "Jean Baggy Vintage Acid Grey", price: "5 800 DA" },
    { src: "assets/articles/jean-noir-surpiqures.jpg", title: "Jean Regular Noir Surpiqûres", price: "5 600 DA" }
  ];

  let track = container.querySelector(".tgh-track");
  if (!track) {
    track = document.createElement("div");
    track.className = "tgh-track";
    container.prepend(track);
  }
  track.innerHTML = "";

  const N = IMAGES.length;
  const cards = IMAGES.map((item, i) => {
    const el = document.createElement("div");
    el.className = "tgh-card";
    el.innerHTML = `
      <img src="${item.src}" alt="${item.title}" loading="lazy" />
      <div class="tgh-card-info">
        <span class="tgh-card-name">${item.title}</span>
        <span class="tgh-card-price">${item.price}</span>
      </div>
    `;
    track.appendChild(el);
    return { el, index: i };
  });

  let progress = 0;
  let isHovered = false;
  container.addEventListener("mouseenter", () => { isHovered = true; });
  container.addEventListener("mouseleave", () => { isHovered = false; });

  let startX = 0, isDragging = false;
  container.addEventListener("pointerdown", e => {
    isDragging = true;
    startX = e.clientX;
  });
  window.addEventListener("pointermove", e => {
    if (!isDragging) return;
    const dx = e.clientX - startX;
    startX = e.clientX;
    progress -= dx * 0.0012;
  });
  window.addEventListener("pointerup", () => { isDragging = false; });

  function tick() {
    if (!isHovered && !isDragging) {
      progress += 0.0014;
    }
    const w = container.clientWidth;
    const radius = Math.max(520, w * 0.72);

    cards.forEach((card, i) => {
      const frac = ((i / N - progress) % 1 + 1) % 1;
      const normAngle = frac * 360 - 180;
      const rad = normAngle * Math.PI / 180;

      if (normAngle > -92 && normAngle < 92) {
        card.el.style.display = "block";
        const x = Math.sin(rad) * radius;
        const z = (Math.cos(rad) - 1) * radius * 0.95;
        const absAngle = Math.abs(normAngle);
        const op = absAngle > 60 ? (88 - absAngle) / 28 : 1;
        card.el.style.opacity = Math.max(0, Math.min(1, op)).toFixed(3);
        card.el.style.transform = `translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${normAngle.toFixed(1)}deg)`;
        card.el.style.zIndex = Math.round(z + 2000);
      } else {
        card.el.style.display = "none";
      }
    });

    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

/* =========================================================
   CROWD CANVAS (Skiper39) — Animation silhouettes streetwear
   ========================================================= */
(function() {
  const canvas = document.getElementById("crowd-canvas");
  if (!canvas) return;

  const ctx = canvas.getContext("2d");
  if (!ctx) return;

  const config = {
    src: "assets/peeps.png",
    rows: 15,
    cols: 7,
  };

  const randomRange = (min, max) => min + Math.random() * (max - min);
  const randomIndex = (array) => randomRange(0, array.length) | 0;
  const removeFromArray = (array, i) => array.splice(i, 1)[0];
  const removeItemFromArray = (array, item) => removeFromArray(array, array.indexOf(item));
  const removeRandomFromArray = (array) => removeFromArray(array, randomIndex(array));
  const getRandomFromArray = (array) => array[randomIndex(array) | 0];

  const resetPeep = ({ stage, peep }) => {
    const direction = Math.random() > 0.5 ? 1 : -1;
    const offsetY = 25 - 90 * (window.gsap ? gsap.parseEase("power2.in")(Math.random()) : Math.random());
    const startY = stage.height - peep.height + offsetY;
    let startX, endX;

    if (direction === 1) {
      startX = -peep.width;
      endX = stage.width;
      peep.scaleX = 1;
    } else {
      startX = stage.width + peep.width;
      endX = 0;
      peep.scaleX = -1;
    }

    peep.x = startX;
    peep.y = startY;
    peep.anchorY = startY;

    return { startX, startY, endX };
  };

  const normalWalk = ({ peep, props }) => {
    const { startX, startY, endX } = props;
    const xDuration = 11;
    const yDuration = 0.26;

    if (!window.gsap) {
      peep.x = startX;
      return null;
    }

    const tl = gsap.timeline();
    tl.timeScale(randomRange(0.65, 1.35));
    tl.to(peep, {
      duration: xDuration,
      x: endX,
      ease: "none",
    }, 0);
    tl.to(peep, {
      duration: yDuration,
      repeat: xDuration / yDuration,
      yoyo: true,
      y: startY - 8,
    }, 0);

    return tl;
  };

  const walks = [normalWalk];
  const stage = { width: 0, height: 0 };
  const allPeeps = [];
  const availablePeeps = [];
  const crowd = [];

  const createPeep = ({ image, rect, scale }) => {
    return {
      image,
      rect,
      width: rect[2] * scale,
      height: rect[3] * scale,
      x: 0,
      y: 0,
      anchorY: 0,
      scaleX: 1,
      walk: null,
      render: function(context) {
        context.save();
        context.translate(this.x, this.y);
        context.scale(this.scaleX, 1);
        context.drawImage(
          this.image,
          this.rect[0],
          this.rect[1],
          this.rect[2],
          this.rect[3],
          0,
          0,
          this.width,
          this.height
        );
        context.restore();
      }
    };
  };

  const createPeeps = (img) => {
    const { rows, cols } = config;
    const width = img.naturalWidth || 3600;
    const height = img.naturalHeight || 2268;
    const total = rows * cols;
    const rectWidth = width / rows;
    const rectHeight = height / cols;
    const targetHeight = Math.min(140, Math.max(90, stage.height * 0.65));
    const scale = targetHeight / rectHeight;

    allPeeps.length = 0;
    for (let i = 0; i < total; i++) {
      allPeeps.push(
        createPeep({
          image: img,
          rect: [
            (i % rows) * rectWidth,
            ((i / rows) | 0) * rectHeight,
            rectWidth,
            rectHeight,
          ],
          scale: scale,
        })
      );
    }
  };

  const addPeepToCrowd = () => {
    if (!availablePeeps.length) return null;
    const peep = removeRandomFromArray(availablePeeps);
    if (!window.gsap) return null;

    const walk = getRandomFromArray(walks)({
      peep,
      props: resetPeep({ peep, stage }),
    });

    if (walk) {
      walk.eventCallback("onComplete", () => {
        removePeepFromCrowd(peep);
        addPeepToCrowd();
      });
      peep.walk = walk;
    }

    crowd.push(peep);
    crowd.sort((a, b) => a.anchorY - b.anchorY);
    return peep;
  };

  const removePeepFromCrowd = (peep) => {
    removeItemFromArray(crowd, peep);
    availablePeeps.push(peep);
  };

  const initCrowd = () => {
    while (availablePeeps.length) {
      const p = addPeepToCrowd();
      if (p && p.walk) p.walk.progress(Math.random());
    }
  };

  const render = () => {
    if (!canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const dpr = window.devicePixelRatio || 1;
    ctx.save();
    ctx.scale(dpr, dpr);

    crowd.forEach((peep) => {
      peep.render(ctx);
    });

    ctx.restore();
  };

  const img = new Image();

  const resize = () => {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    stage.width = rect.width || canvas.clientWidth;
    stage.height = rect.height || canvas.clientHeight;
    if (stage.width === 0 || stage.height === 0) return;

    const dpr = window.devicePixelRatio || 1;
    canvas.width = stage.width * dpr;
    canvas.height = stage.height * dpr;

    crowd.forEach((peep) => {
      if (peep.walk) peep.walk.kill();
    });
    crowd.length = 0;

    createPeeps(img);
    availablePeeps.length = 0;
    availablePeeps.push(...allPeeps);

    initCrowd();
  };

  const init = () => {
    resize();
    if (window.gsap && gsap.ticker) {
      gsap.ticker.add(render);
    } else {
      const loop = () => { render(); requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
    }
    window.addEventListener("resize", resize);
  };

  img.onload = init;
  img.src = config.src;
})();

/* =========================================================
   STROKE DRAW TYPE (DOUBLE ONE) — Tracé & Remplissage Liquide
   ========================================================= */
(function() {
  const wrap = document.getElementById("footer-stroke-wrap");
  const strokeText = document.getElementById("sdt-stroke-text");
  const liquidPath = document.getElementById("sdt-liquid-path");
  const penTip = document.getElementById("sdt-pen-tip");
  if (!wrap || !strokeText || !liquidPath) return;

  let totalLength = 1800;
  try {
    const len = strokeText.getComputedTextLength ? strokeText.getComputedTextLength() : 820;
    if (len > 100) totalLength = Math.max(1600, len * 2.3);
  } catch(e) {}

  strokeText.style.strokeDasharray = totalLength + " " + totalLength;
  strokeText.style.strokeDashoffset = totalLength;

  const state = {
    drawProgress: 0,
    fillLevel: 0,
    targetFill: 1,
    wavePhase: 0,
    isHovered: false,
    started: false
  };

  function updateLiquidPath(level, phase) {
    const H = 190;
    // Map level 0..1 to height (from 190 down to 20)
    const y = H - (level * (H - 22));
    const amp = (level > 0.02 && level < 0.98) ? 6 : (level > 0 ? 1.5 : 0);

    let d = "M 0 190 L 0 " + y.toFixed(1);
    const steps = 14;
    for (let i = 0; i <= steps; i++) {
      const x = (1000 / steps) * i;
      const wy = y + Math.sin(x * 0.018 + phase) * amp + Math.cos(x * 0.032 - phase * 0.8) * (amp * 0.5);
      d += " L " + x.toFixed(1) + " " + wy.toFixed(1);
    }
    d += " L 1000 190 Z";
    liquidPath.setAttribute("d", d);
  }

  function tick() {
    state.wavePhase += 0.055;
    const speed = state.isHovered ? 0.045 : 0.028;
    state.fillLevel += (state.targetFill - state.fillLevel) * speed;

    updateLiquidPath(state.fillLevel, state.wavePhase);
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  function startAnimation() {
    if (state.started) return;
    state.started = true;

    if (window.gsap) {
      if (penTip) penTip.setAttribute("opacity", "1");

      gsap.to(state, {
        drawProgress: 1,
        duration: 1.8,
        ease: "power2.inOut",
        onUpdate: function() {
          const off = totalLength * (1 - state.drawProgress);
          strokeText.style.strokeDashoffset = off.toFixed(1);
          if (penTip) {
            const px = 110 + state.drawProgress * 780;
            const py = 120 + Math.sin(state.drawProgress * Math.PI * 4.5) * 22;
            penTip.setAttribute("cx", px.toFixed(1));
            penTip.setAttribute("cy", py.toFixed(1));
          }
        },
        onComplete: function() {
          if (penTip) {
            gsap.to(penTip, { opacity: 0, duration: 0.4 });
          }
          gsap.to(state, {
            targetFill: 1,
            duration: 1.1,
            ease: "power2.out"
          });
        }
      });
    } else {
      strokeText.style.strokeDashoffset = "0";
      state.targetFill = 1;
    }
  }

  wrap.addEventListener("pointerenter", function() {
    state.isHovered = true;
    state.targetFill = 0.06; // drains down leaving a small pool
  });

  wrap.addEventListener("pointerleave", function() {
    state.isHovered = false;
    state.targetFill = 1; // refills like liquid in a glass
  });

  wrap.addEventListener("click", function() {
    state.targetFill = 0;
    strokeText.style.strokeDashoffset = totalLength;
    state.started = false;
    startAnimation();
  });

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) {
        startAnimation();
        io.disconnect();
      }
    }, { threshold: 0.25 });
    io.observe(wrap);
  } else {
    startAnimation();
  }
})();

/* =========================================================
   APPEAR TEXT (DOUBLE ONE) — Animation de texte répétée
   ========================================================= */
(function() {
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
  const mix = (a, b, t) => a + (b - a) * t;
  const seg = (t, a, b) => clamp((t - a) / Math.max(b - a, 1e-6), 0, 1);
  const ease = (t) => {
    const x = clamp(t, 0, 1);
    return x * x * x * (x * (x * 6 - 15) + 10);
  };
  const oddUp = (value) => {
    const n = Math.max(1, Math.round(value));
    return n % 2 === 0 ? n + 1 : n;
  };

  const REST_FLOOR = 0.05;
  const RESET_SHARE = 0.35;
  const REVEAL_SHARE = 0.75;
  const CUT_SHARE = 0.5;

  function timelineFor({ expandSeconds, holdSeconds } = {}) {
    const spread = Math.max(0.100007, Number(expandSeconds) || 0);
    const held = Math.max(0, Number(holdSeconds) || 0);
    const tSpread = spread;
    const tWipe = tSpread + spread;
    const tWord = tWipe + held;
    const tReset = tWord + spread * RESET_SHARE;
    const tReveal = tReset + spread * REVEAL_SHARE;
    const total = tReveal + Math.max(0.200002, held * 0.4);
    return { tSpread, tWipe, tWord, tReset, tReveal, total };
  }

  function gridPlan(config = {}) {
    const rowCount = oddUp(config.rowCount ?? 1);
    const wordCount = oddUp(config.repeatCount ?? 5);
    const centerRow = (rowCount - 1) / 2;
    const centerWord = (wordCount - 1) / 2;
    const shift = Number(config.driftDistance) || 0;
    const rest = clamp((Number(config.restingOffset) || 0) / 100, REST_FLOOR, 1);
    const reach = Math.max(centerRow, 1);

    const rows = [];
    for (let row = 0; row < rowCount; row += 1) {
      const distance = Math.abs(row - centerRow);
      const magnitude = shift * (0.7 + 0.9 * (distance / reach));
      const direction = row % 2 === 0 ? 1 : -1;
      const full = direction * magnitude;
      const leftToRight = direction > 0;
      const words = [];
      for (let word = 0; word < wordCount; word += 1) {
        const along = wordCount > 1 ? word / (wordCount - 1) : 0;
        words.push({
          index: word,
          hero: row === centerRow && word === centerWord,
          sweepT: leftToRight ? along : 1 - along
        });
      }
      rows.push({
        index: row,
        hero: row === centerRow,
        leftToRight,
        full,
        home: full * rest,
        words
      });
    }
    return { rowCount, wordCount, centerRow, centerWord, rows };
  }

  function rowOffsetAt(row, timeline, t) {
    const { tSpread, tWipe, tWord, tReset, tReveal } = timeline;
    if (t <= tSpread) return mix(row.home, row.full, ease(seg(t, 0, tSpread)));
    if (row.hero) {
      if (t <= tWipe) return mix(row.full, 0, ease(seg(t, tSpread, tWipe)));
      if (t <= tReset) return 0;
      if (t <= tReveal) return mix(0, row.home, ease(seg(t, tReset, tReveal)));
      return row.home;
    }
    if (t <= tWord) return row.full;
    if (t <= tReset) return mix(row.full, row.home, ease(seg(t, tWord, tReset)));
    return row.home;
  }

  function wordCoverAt(sweepT, timeline, t) {
    const { tSpread, tWipe, tReset, tReveal } = timeline;
    const cutOut = (tWipe - tSpread) * CUT_SHARE;
    const outStart = tSpread + sweepT * (tWipe - tSpread - cutOut);
    const outEnd = outStart + cutOut;
    if (t <= outStart) return 0;
    if (t <= outEnd) return ease(seg(t, outStart, outEnd));
    if (t <= tReset) return 1;
    const cutIn = (tReveal - tReset) * CUT_SHARE;
    const inStart = tReset + sweepT * (tReveal - tReset - cutIn);
    const inEnd = inStart + cutIn;
    if (t <= inStart) return 1;
    if (t <= inEnd) return 1 - ease(seg(t, inStart, inEnd));
    return 0;
  }

  function zoomAt(timeline, zoom, t) {
    const { tSpread, tWipe } = timeline;
    if (t <= tSpread) return mix(1, zoom, ease(seg(t, 0, tSpread)));
    if (t <= tWipe) return mix(zoom, 1, ease(seg(t, tSpread, tWipe)));
    return 1;
  }

  function clipFor(cover, leftToRight) {
    if (cover <= 0.000500004) return 'inset(0% 0% 0% 0%)';
    const cut = (clamp(cover, 0, 1) * 100).toFixed(3);
    return leftToRight ? `inset(0% 0% 0% ${cut}%)` : `inset(0% ${cut}% 0% 0%)`;
  }

  function buildAppearText(root, initial = {}) {
    if (!root) return { setConfig() {}, destroy() {} };
    const doc = root.ownerDocument;
    const win = doc?.defaultView;
    if (!win) return { setConfig() {}, destroy() {} };

    const reduced = win.matchMedia('(prefers-reduced-motion: reduce)');
    let config = { ...initial };
    let plan = gridPlan(config);
    let timeline = timelineFor(config);
    let grid = null;
    let rowNodes = [];
    let raf = 0;
    let last = 0;
    let clock = 0;
    let visible = true;
    let destroyed = false;

    const still = () => reduced.matches || !(Number(config.expandSeconds) > 0);
    const wrote = new Map();
    const write = (node, key, value) => {
      const id = `${key}:${node.__aptId}`;
      if (wrote.get(id) === value) return;
      wrote.set(id, value);
      if (key === 'transform') node.style.transform = value;
      else node.style.clipPath = value;
    };

    function buildDom() {
      wrote.clear();
      grid = doc.createElement('div');
      grid.className = 'apt-grid';
      grid.__aptId = 'grid';
      rowNodes = [];
      const text = String(config.text ?? '');
      let id = 0;
      for (const row of plan.rows) {
        const rowNode = doc.createElement('div');
        rowNode.className = 'apt-row';
        rowNode.__aptId = `r${row.index}`;
        const words = [];
        for (const word of row.words) {
          const span = doc.createElement('span');
          span.className = word.hero ? 'apt-word apt-word--hero' : 'apt-word';
          span.__aptId = `w${(id += 1)}`;
          span.textContent = text;
          rowNode.appendChild(span);
          words.push({ node: span, model: word });
        }
        grid.appendChild(rowNode);
        rowNodes.push({ node: rowNode, model: row, words });
      }
      root.replaceChildren(grid);
    }

    function pose(t) {
      write(grid, 'transform', `translate(-50%,-50%) scale(${zoomAt(timeline, config.zoomScale ?? 1, t).toFixed(4)})`);
      for (const row of rowNodes) {
        write(row.node, 'transform', `translate3d(${rowOffsetAt(row.model, timeline, t).toFixed(2)}px,0,0)`);
        for (const word of row.words) {
          if (word.model.hero) continue;
          write(word.node, 'clip', clipFor(wordCoverAt(word.model.sweepT, timeline, t), row.model.leftToRight));
        }
      }
    }

    function poseAtRest() {
      write(grid, 'transform', 'translate(-50%,-50%) scale(1)');
      for (const row of rowNodes) {
        write(row.node, 'transform', `translate3d(${row.model.home.toFixed(2)}px,0,0)`);
        for (const word of row.words) {
          if (word.model.hero) continue;
          write(word.node, 'clip', 'inset(0% 0% 0% 0%)');
        }
      }
    }

    function tick(time) {
      raf = 0;
      if (destroyed || !visible || doc.hidden) return;
      const delta = last ? clamp((time - last) / 1000, 0, 0.0500002) : 0;
      last = time;
      clock = (clock + delta) % timeline.total;
      pose(clock);
      raf = win.requestAnimationFrame(tick);
    }

    function schedule() {
      if (destroyed || raf || !visible || doc.hidden) return;
      if (still()) {
        poseAtRest();
        return;
      }
      last = 0;
      raf = win.requestAnimationFrame(tick);
    }

    function stop() {
      if (raf) win.cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
    }

    const onVisibility = () => {
      if (doc.hidden) stop();
      else schedule();
    };
    const onMotionChange = () => {
      stop();
      if (still()) poseAtRest();
      else schedule();
    };

    const intersection = new win.IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
      if (visible) schedule();
      else stop();
    });
    intersection.observe(root);
    doc.addEventListener('visibilitychange', onVisibility);
    reduced.addEventListener('change', onMotionChange);

    buildDom();
    if (still()) poseAtRest();
    else {
      pose(clock);
      schedule();
    }

    return {
      setConfig(next = {}) {
        config = { ...config, ...next };
        plan = gridPlan(config);
        timeline = timelineFor(config);
        buildDom();
        stop();
        if (still()) poseAtRest();
        else {
          pose(clock);
          schedule();
        }
      },
      destroy() {
        destroyed = true;
        stop();
        intersection.disconnect();
        doc.removeEventListener('visibilitychange', onVisibility);
        reduced.removeEventListener('change', onMotionChange);
        root.replaceChildren();
      }
    };
  }

  const root = document.querySelector('.apt-root');
  if (root) {
    const aptInstance = buildAppearText(root, {
      "text": "DOUBLE ONE",
      "rowCount": 1,
      "repeatCount": 5,
      "expandSeconds": 1.2,
      "holdSeconds": 1.1,
      "driftDistance": 85,
      "restingOffset": 38,
      "zoomScale": 1.15
    });
    window.addEventListener('pagehide', () => aptInstance.destroy(), { once: true });
  }
})();
</script>
</body>
</html>
